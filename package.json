{
  "name": "@itsrighttime/irt-ui",
  "version": "0.1.0",
  "description": "Theme-configurable, fully typed React UI library (atoms + workspace layout) for React and Next.js apps.",
  "license": "UNLICENSED",
  "author": "Indradhar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsrighttime/irt-ui.git"
  },
  "homepage": "https://itsrighttime.github.io/irt-ui/",
  "bugs": {
    "url": "https://github.com/itsrighttime/irt-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "docs/AI_USAGE_GUIDE.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./atoms": {
      "types": "./dist/components/atoms/index.d.ts",
      "import": "./dist/components/atoms/index.js"
    },
    "./layout": {
      "types": "./dist/components/layout/index.d.ts",
      "import": "./dist/components/layout/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "import": "./dist/markdown/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens": "vitest run src/theme/tokens.test.ts",
    "check:exports": "publint && attw --pack . --profile esm-only",
    "validate": "npm run typecheck && npm run typecheck:playground && npm run lint && npm run test && npm run build && npm run check:exports",
    "prepublishOnly": "npm run validate",
    "pack:local": "npm run build && node scripts/pack-local.mjs",
    "playground:dev": "vite --config playground/vite.config.ts",
    "playground:build": "npm run docs:props && vite build --config playground/vite.config.ts",
    "docs:props": "node scripts/generate-props.mjs",
    "playground:preview": "vite preview --config playground/vite.config.ts",
    "typecheck:playground": "tsc -p playground/tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "react-markdown": ">=9.0.0",
    "react-syntax-highlighter": ">=15.5.0",
    "remark-gfm": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react-markdown": {
      "optional": true
    },
    "react-syntax-highlighter": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "remark-gfm": "^4.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
